# Public browser config. The publishable key is safe to expose; Supabase RLS
# protects browser access.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secret. Never expose it in HTML or commit its value.
SUPABASE_SECRET_KEY=your-supabase-secret-key
